{
  "name": "the-gang",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "test": "node --test \"shared/test/**/*.test.ts\" \"server/test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspace @the-gang/web",
    "dev:server": "npm run dev --workspace @the-gang/server",
    "dev:web": "npm run dev --workspace @the-gang/web"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "socket.io-client": "^4.8.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.18"
  }
}